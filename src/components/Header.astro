---
// src/components/Header.astro
// Props: { isHomePage: boolean }
import { getPublishedChaptersSorted } from '../lib/prose.js';
import { getVolumes } from '../lib/volumes.js';
import { SHOW_PROSE } from '../lib/features.js';
import ThemeToggle from './ThemeToggle.astro';

const { isHomePage } = Astro.props;

// One nav link per volume with published chapters; the same source the
// volume pages are generated from. Rendering is gated by SHOW_PROSE
// below, not this computation - cheap enough at build time either way.
const volumes = getVolumes(await getPublishedChaptersSorted());
---

<div class="header-container fixed" id="site-header">
  <div class="header-controls">
    <div class="header-logo">
      {isHomePage ? (
        <a class="button" href="#section-top" id="logo-home-link">
          Patrick Petrushonis
        </a>
      ) : (
        <a class="button" href="/">
          Patrick Petrushonis
        </a>
      )}
    </div>

    <div class="header-controls__nav-toggle">
      <!--
        The checkbox's icon-morph animation (_header.scss's
        `input:checked + span`) requires its immediate next sibling to
        be a literal <span>, so the label wraps both rather than being
        the icon element itself - clicking anywhere in the label still
        toggles the checkbox.
      -->
      <label>
        <input type="checkbox" name="nav-toggle" id="nav-toggle" />
        <span class="nav-icon"></span>
      </label>
    </div>

    <!-- Floats right after the hamburger: left of it on narrow screens,
         rightmost on wide ones where the hamburger is hidden. -->
    <ThemeToggle />

    <ul id="nav-list">
      <li>
        <a
          class="button"
          href={isHomePage ? '#section-about' : '/#section-about'}
          data-scroll="true"
        >
          About
        </a>
      </li>
      <li>
        <a
          class="button"
          href={isHomePage ? '#section-projects' : '/#section-projects'}
          data-scroll="true"
        >
          Projects
        </a>
      </li>
      {SHOW_PROSE && volumes.map((volume) => (
        <li>
          <a class="button" href={`/volumes/${volume}/`}>
            Volume {volume}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import { initHeader } from '../utils/header.js';
  initHeader();
</script>