---
// src/components/ThemeToggle.astro
// Switches between light and dark. Layout.astro's inline <head> script
// sets data-theme before first paint; this component flips it and
// remembers the choice. Both use the localStorage key 'theme': keep
// the key and the 'light' | 'dark' values in sync with that script.
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<script>
  import { initThemeToggle } from '../utils/theme.js';
  initThemeToggle('theme-toggle');
</script>